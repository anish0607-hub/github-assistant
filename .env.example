# ---------- Backend ----------
PORT=4000

# PostgreSQL (docker-compose provides this by default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_assistant

# Redis (job queue for repository indexing)
REDIS_URL=redis://localhost:6379

# Qdrant vector database
QDRANT_URL=http://localhost:6333

# Anthropic Claude (chat, explanations, docs, bug detection, commit analysis)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# Embeddings provider: "openai" or "voyage"
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=sk-...
# EMBEDDINGS_MODEL=text-embedding-3-small
# VOYAGE_API_KEY=pa-...

# GitHub token (optional — raises rate limits and allows private repos)
GITHUB_TOKEN=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
